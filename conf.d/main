#!/bin/bash -ex
# MariaDB, and nothing that serves a web page.
#
# common's conf/mysql has already run (COMMON_CONF of mk/turnkey/mysql.mk):
# it installed mysqltuner, linked /etc/init.d/mysql to the mariadb script,
# and removed the anonymous users, the remote root accounts and the test
# database. Two things are left, and both are about the password a declared
# instance hands to the database.
#
# 1. The administrative account. Upstream creates it in conf/adminer-mysql,
#    names it after Adminer, and the first boot hook that resets its
#    password (35adminer-mysqlpass) ships in the Adminer overlay. This
#    layer has no Adminer, so it creates the account itself, named 'admin',
#    and ships its own hook (overlay firstboot.d/35mysqlpass).
#
# 2. The account is created unusable rather than with a build time
#    password. A layer is published once and reused by every appliance
#    built on it, so a password chosen here would be the same password on
#    all of them, and a random one would make the layer irreproducible
#    (brief section 5.4: same commit plus same manifest, same bytes). The
#    hash below is not the hash of any string, which is the documented way
#    to leave an account that cannot authenticate; firstboot.d/35mysqlpass
#    replaces it with a real one from DB_PASS.

MARIADB_ADMIN_USER="admin"
# No input hashes to this value, so the account authenticates nothing.
MARIADB_INVALID_HASH='*THISISNOTAVALIDPASSWORDTHATCANBEUSEDHERE'
# One account per host: MariaDB matches a socket connection against
# 'localhost' and a TCP connection against the literal address.
MARIADB_ADMIN_HOSTS="localhost ::1 127.0.0.1"

service mysql start

for host in $MARIADB_ADMIN_HOSTS; do
    mysql <<EOF
CREATE USER IF NOT EXISTS '$MARIADB_ADMIN_USER'@'$host'
    IDENTIFIED VIA mysql_native_password USING '$MARIADB_INVALID_HASH';
GRANT ALL PRIVILEGES ON *.* TO '$MARIADB_ADMIN_USER'@'$host' WITH GRANT OPTION;
EOF
done
mysql -e "FLUSH PRIVILEGES"

# The account exists on every host and none of them can log in yet: that is
# the state this layer is published in.
for host in $MARIADB_ADMIN_HOSTS; do
    mysql -N -B -e "SELECT COUNT(*) FROM mysql.global_priv \
        WHERE User='$MARIADB_ADMIN_USER' AND Host='$host'" | grep -qx 1
done

service mysql stop

# The bind addresses of the overlay are what the server must come up with.
grep -qx 'bind-address = ::1,127.0.0.1' /etc/mysql/mariadb.conf.d/99-keel-bind.cnf

# webmin-mysql is what puts the database in the panel core already carries;
# the plan asks for it, so fail the build rather than ship a panel without
# its database module (the boot test checks the running appliance too).
dpkg-query -W -f '${Status}' webmin-mysql | grep -qx 'install ok installed'

# fab-plan-resolve keeps a package the parent layer already carries at the
# parent's version, so the two core packages are upgraded here from the
# build time source (keel, new in the plan, was installed from it already).
#
# The overlay of this layer ships /etc/confconsole/services.txt, which is a
# conffile of confconsole, so dpkg sees it as locally modified and asks what
# to do with it. The conf script runs with stdin closed, dpkg reads end of
# file at the prompt and leaves confconsole "install ok unpacked", which
# fails this script. Keep the overlay's file without asking.
#
# The build time archive has to win over every other source here: a
# bootstrap from before Keel-Linux/common#30 pins TurnKey's archive at 999.
# It used to win through the overlay's /etc/apt/preferences.d/keel at 1001,
# which then shipped in the image and downgraded every package newer than the
# archive's (tracker#23). This pin names the staging distribution by its
# Label, exists only during the build and goes with the build time source.
printf 'Package: *\nPin: release l=Keel Linux staging\nPin-Priority: 1001\n' \
    > /etc/apt/preferences.d/keel-staging
export DEBIAN_FRONTEND=noninteractive
apt-get install -y --only-upgrade \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    inithooks confconsole

# A half configured package keeps its new version, so check the state too.
[[ $(dpkg-query -W -f '${Status}\n' inithooks confconsole keel \
    | grep -c '^install ok installed$') -eq 3 ]]

# A floor, not a literal: the declarative first boot this layer depends on
# landed in these versions, and a build that read a stale index would ship
# a layer whose whole point does not work. keel-nodebb's
# conf.d/zz-project-packages is where the archive freshness check itself is
# maintained; this is the minimum, which is what publishing this layer
# requires.
#
# keel 0.3.5 is the floor because the two node gate configures replication
# from the description on the booted machine: that needs the database section
# (0.3.0), what inspect and diff read back from it (0.3.1 to 0.3.3), the role
# configuration apply writes (0.3.4) and promotion (0.3.5). A layer built with
# keel 0.2.1 answers "database: unknown top level key" and the gate fails, so
# the floor is the version the layer is published to carry.
while read -r package floor; do
    installed=$(dpkg-query -W -f '${Version}' "$package")
    dpkg --compare-versions "$installed" ge "$floor" \
        || { echo "$package $installed is older than $floor" >&2; exit 1; }
done <<EOF
inithooks 2.3.6+keel4
confconsole 2.2.3+keel2
keel 0.3.5
EOF
dpkg-query -W -f '${Package} ${Version} ${Status}\n' inithooks confconsole keel

# The build time package source is not for appliances: remove the source
# entry, its build time pin, the copy of the archive it names and the keyring
# the build verified that archive with. The staging key signs whatever the
# build host produced, so an image that kept it would carry trust in a
# nightly (tracker#7). common/removelists-final/turnkey removes the same
# paths at the end of the build, whatever a recipe does. The appliance's own
# Keel source and its 990 pin are common's (overlays/turnkey.d/keel-apt), so
# nothing the image keeps may still name the build time archive.
rm -f /etc/apt/sources.list.d/keel-staging.list
rm -f /etc/apt/preferences.d/keel-staging
rm -f /etc/apt/keyrings/keel-staging-keyring.asc
rm -rf /srv/keel-apt
rm -rf /var/lib/apt/lists/*
if grep -rlsE 'trixie-staging|/srv/keel-apt|l=Keel Linux staging' /etc/apt/sources.list \
    /etc/apt/sources.list.d /etc/apt/preferences /etc/apt/preferences.d; then
    echo "the apt files above still name the build time archive" >&2
    exit 1
fi
