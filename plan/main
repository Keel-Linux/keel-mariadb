#include <turnkey/base>

/* MariaDB, python3-pymysql (bin/mysqlconf.py) and webmin-mysql, the module
   that puts the database in the panel core already carries. */
#include <turnkey/mysql>

/* the command line client: the appliance talks to its own database over
   loopback, and the first boot hook proves the password it just set */
mariadb-client

/* project packages, from the Keel archive (archive.keellinux.org) */
inithooks
confconsole
keel

/* The appliance manifest of Keel MariaDB (handbook decision 0041), from
   packages/keel-mariadb: /usr/share/keel/appliances/mariadb.yaml, so a spec
   may say appliance.name: mariadb and declare the pair of
   docs/replication.md. It depends on keel-core, which the parent layer
   carries, and on mariadb-server, which turnkey/mysql brings. */
keel-mariadb
