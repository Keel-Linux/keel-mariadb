#!/bin/sh
# On purge, remove the masks postinst made on the socket units of
# mariadb-server (keel-mariadb#29). deb-systemd-helper removes only a mask
# it recorded, so a mask the operator or the image made stays.
set -e

case "$1" in
    purge)
        deb-systemd-helper unmask mariadb.socket mariadb-extra.socket
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
